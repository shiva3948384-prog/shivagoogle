# ============================================================================
# Smarter AI — Client Build Configuration (.env.example)
# ============================================================================
# Copy this file to `.env` or set these values in the AI Studio Secrets panel.
#
# SECURITY NOTICE:
# Only public Supabase client identifiers belong in this file.
# NEVER put APINEX_API_KEY, SUPABASE_SERVICE_ROLE_KEY, or BREVO_API_KEY in `.env`
# or anywhere inside the Android APK. All server-side secrets must be stored
# in your Supabase Edge Function environment (`supabase secrets set APINEX_API_KEY=...`).

# Your Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://xwkfyamulhfptgywlvef.supabase.co

# Your Supabase Project Public Anon Key (safe for client use with Row-Level Security enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh3a2Z5YW11bGhmcHRneXdsdmVmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMyOTI4MDUsImV4cCI6MjEwODg2ODgwNX0.8LwsNDI8HAniFgQBtGX_iHJ4BW8EYCqltX9cs0hOQxs

# Your Deployed Supabase Edge Function Gateway Endpoint
